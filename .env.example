# ============================================================
# SEAESCAPE ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=production

# ============================================================
# PAYMENT GATEWAY: IPAY88 (Recommended for Malaysia)
# ============================================================
# Sign up at: https://ipay88.com
# Get your credentials from: Dashboard > Settings > Merchant Code
IPAY88_CODE=M12345678
IPAY88_KEY=your_secret_key_here

# ============================================================
# PAYMENT GATEWAY: STRIPE (For International Customers)
# ============================================================
# Sign up at: https://stripe.com
# Get keys from: Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_PUBLIC_KEY=pk_live_your_public_key_here

# ============================================================
# DOMAIN & WEBSITE SETTINGS
# ============================================================
# Your website domain (used for payment redirects)
# Example: https://seaescape.my or https://your-site.railway.app
DOMAIN=https://seaescape.my

# Your website name
WEBSITE_NAME=SeaEscape

# ============================================================
# DATABASE (Optional - for future expansion)
# ============================================================
# MongoDB or PostgreSQL connection string
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/seaescape

# ============================================================
# EMAIL SERVICE (Optional - for customer notifications)
# ============================================================
# Mailgun, SendGrid, or similar
# EMAIL_API_KEY=your_email_service_key
# EMAIL_FROM=booking@seaescape.my

# ============================================================
# TWILIO (Optional - for SMS notifications)
# ============================================================
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE=+60123456789

# ============================================================
# ANALYTICS & LOGGING (Optional)
# ============================================================
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# SENTRY_DSN=your_sentry_dsn

# ============================================================
# NOTES FOR RAILWAY DEPLOYMENT
# ============================================================
# When deploying to Railway:
# 1. Go to your Railway project
# 2. Click "Variables"
# 3. Add each variable above (copy the KEY=VALUE)
# 4. Click "Save"
# 5. Redeploy
# 
# Railway will automatically set PORT and NODE_ENV
# You only need to add IPAY88_CODE, IPAY88_KEY, STRIPE keys, etc.
